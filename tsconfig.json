{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "lib": [
      "es2022",
      "dom"
    ],
    "types": []
  },
  "include": [
    "src",
    "addon/**/*.ts",
    "typings",
    "shared"
  ]
}
